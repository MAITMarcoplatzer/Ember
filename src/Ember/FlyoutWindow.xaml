<Window x:Class="Ember.FlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ember"
        Width="360"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <SolidColorBrush x:Key="BgBrush" Color="#F9F9F9" />
        <SolidColorBrush x:Key="TextBrush" Color="#1A1A1A" />
        <SolidColorBrush x:Key="MutedBrush" Color="#5F5E5A" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#ECECEC" />
        <SolidColorBrush x:Key="EdgeBrush" Color="#D8D8D8" />
        <SolidColorBrush x:Key="AccentBrush" Color="#D85A30" />

        <Style x:Key="FlatButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource SurfaceBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="RootBorder"
            Background="{DynamicResource BgBrush}"
            BorderBrush="{DynamicResource EdgeBrush}"
            BorderThickness="1"
            Padding="16,14">
        <StackPanel>

            <Grid Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{DynamicResource AccentBrush}" CornerRadius="5"
                            Width="20" Height="20" Margin="0,0,8,0">
                        <TextBlock Text="&#xE945;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="12" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Ember" FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="CodeBurn für Windows" FontSize="11" Margin="8,0,0,0"
                               Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
                </StackPanel>
                <Button x:Name="BtnRefresh" Style="{StaticResource FlatButton}"
                        HorizontalAlignment="Right" Padding="6" ToolTip="Aktualisieren"
                        Click="OnRefreshClick">
                    <TextBlock Text="&#xE72C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               FontSize="13" Foreground="{DynamicResource MutedBrush}" />
                </Button>
            </Grid>

            <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="7" Padding="3"
                    Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="TabToday" Grid.Column="0" Style="{StaticResource FlatButton}"
                            Content="Heute" Click="OnTabTodayClick" />
                    <Button x:Name="TabMonth" Grid.Column="1" Style="{StaticResource FlatButton}"
                            Content="Monat" Click="OnTabMonthClick" />
                </Grid>
            </Border>

            <TextBlock x:Name="BigText" Text="–" FontSize="30" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextBrush}" Margin="0,0,0,2" />
            <TextBlock x:Name="SubText" Text="Lade Daten…" FontSize="12"
                       Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,14" />

            <TextBlock Text="Top-Modelle" FontSize="12" FontWeight="SemiBold"
                       Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,7" />
            <StackPanel x:Name="ModelsPanel" Margin="0,0,0,12" />

            <TextBlock Text="Top-Projekte" FontSize="12" FontWeight="SemiBold"
                       Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,7" />
            <StackPanel x:Name="ProjectsPanel" Margin="0,0,0,12" />

            <Border BorderBrush="{DynamicResource EdgeBrush}" BorderThickness="0,1,0,0"
                    Padding="0,10,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Style="{StaticResource FlatButton}"
                            HorizontalAlignment="Left" Click="OnDashboardClick">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE9D9;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource MutedBrush}" />
                            <TextBlock Text="Dashboard öffnen" Foreground="{DynamicResource TextBrush}" />
                        </StackPanel>
                    </Button>
                    <TextBlock x:Name="StatusText" Grid.Column="1" FontSize="11"
                               Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
                </Grid>
            </Border>
        </StackPanel>
    </Border>
</Window>
